@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
    <link rel="stylesheet" href="../Content/main-css/volunteer.css">
    <div class="container1">
        <p class="mb-4">Every wag, purr, and happy pawprint begins with kindness. By volunteering your time, you give rescued dogs and cats the love and care they need while waiting for their furever pawmilies.</p>
        <button class="sign-up-btn" ng-click="volunteerForm()">sign up here</button>
        <img class="volunteer-banner" src="../Content/images/volunteer-banner.jpg" alt="Woman with Dogs" />
        <div class="shadow"></div>
    </div>
    <div class="container2">
        <div class="subcontainer2">
            <p class="mb-1">why you should volunteer?</p>
            <p>Volunteering with Found Pawmily goes beyond spending time with animals. It changes lives, both theirs and yours.</p>
            <div class="d-flex">
                <div class="pink-paw-container">
                    <img class="pink-paw" src="../Content/images/paw-pink.png" alt="Pink paw" />
                    <img class="pink-paw" src="../Content/images/paw-pink.png" alt="Pink paw" />
                    <img class="pink-paw" src="../Content/images/paw-pink.png" alt="Pink paw" />
                    <img class="pink-paw" src="../Content/images/paw-pink.png" alt="Pink paw" />
                </div>
                <ul class="why-volunteer ps-3">
                    <li>Give Comfort & Love</li>
                    <li>Many of our rescues have known fear, hunger, or neglect. Your presence shows them that people can be gentle and kind.</li>
                    <li>Prepare Pets for Adoption</li>
                    <li>Socialized, well-cared-for pets are more likely to be adopted. A simple walk, cuddle, or playtime helps build their confidence.</li>
                    <li>Support the Shelters</li>
                    <li>Feeding, cleaning, and assisting with daily tasks ease the load of shelter staff, allowing them to focus on rescuing and caring for more animals.</li>
                    <li>Be Part of Their Journey</li>
                    <li>Every small act, from filling a food bowl to brushing a dog’s fur, brings a rescued pet one step closer to a forever home.</li>
                </ul>
            </div>
        </div>
        <img class="container2-image" src="../Content/images/volunteer-container2-image.jpg" alt="Dogs on a bench" />
    </div>
    <div class="container3">
        <p class="mb-5">what volunteers can do!</p>
        <div class="subcontainer3">
            <div>
                <img class="mb-2" src="../Content/images/volunteer-walk.png" alt="People walking the dogs" />
                <p>Walking the Dogs</p>
            </div>
            <div>
                <img src="../Content/images/volunteer-feed.png" alt="A cat eating" />
                <p style="width: 15vw; text-align: center;">Feeding our Furiends</p>
            </div>
            <div>
                <img class="mb-2" src="../Content/images/volunteer-bond.png" alt="A woman playing with two dogs" />
                <p>Bonding & Playing</p>
            </div>
            <div>
                <img src="../Content/images/volunteer-clean.png" alt="A man cleaning the shelter" />
                <p style="width: 15vw; text-align: center;">Cleaning & Maintenance</p>
            </div>
        </div>
    </div>
    <div class="container4">
        <p class="mb-5">how to apply?</p>
        <div class="subcontainer4">
            <div class="subsubcontainer4">
                <img style="margin-left: 2vw;" src="../Content/images/volunteer-apply-1.png" alt="Clipboard" />
                <p class="mb-1">Sign Up</p>
                <p class="mb-0">Fill out the <a style="color: #D25D5D; font-family: 'Open-Sans-Bold'; text-decoration: underline; cursor: pointer;" ng-click="volunteerForm()">Volunteer Form</a> with your preferred schedule and shelter location. You can book 1 month advance at most!</p>
            </div>
            <div class="subsubcontainer4">
                <img style="padding: 1.3vw;" src="../Content/images/volunteer-apply-2.png" alt="Check mark" />
                <p class="mb-1">Confirmation</p>
                <p class="mb-0">We’ll contact you via email to confirm your volunteer slot.</p>
            </div>
            <div class="subsubcontainer4">
                <img src="../Content/images/volunteer-apply-3.png" alt="Shake hands in a form of a heart shape" />
                <p class="mb-1">Show Up</p>
                <p class="mb-0">On your chosen date and time, arrive at the shelter and meet our staff and rescues.</p>
            </div>
        </div>
    </div>
    <div class="container5">
        <p>frequently asked questions (FAQs)</p>
        <div class="accordion" id="faqs" style="width: 80vw;">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        Do I need prior experience with animals?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#faqs">
                    <div class="accordion-body">
                        No experience required! Our team will guide you, and there are activities suitable for all comfort levels.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Can I volunteer with friends or as a group?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqs">
                    <div class="accordion-body">
                        Yes! Just sign-up in the volunteer form under the same date and time so we can schedule you together.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        What should I bring on volunteer day?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#faqs">
                    <div class="accordion-body">
                        Comfortable clothes, closed shoes, a refillable water bottle, and lots of energy. Optional: treats, toys, or cleaning supplies to donate.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        Is there an age requirement?
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#faqs">
                    <div class="accordion-body">
                        Volunteers must be at least 18 years old. Younger kids can join if accompanied by a parent/guardian.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                        How long does a volunteer session last?
                    </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse" data-bs-parent="#faqs">
                    <div class="accordion-body">
                        It typically lasts an hour, depending on your availability and the shelter’s needs.
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="../Scripts/bootstrap.min.js"></script>
    <script>
        const navbar = document.getElementById("navbar");

        window.addEventListener("scroll", () => {
            if (window.scrollY > 350) {
                navbar.style.backgroundColor = "rgb(210, 93, 93)";
                navbar.style.boxShadow = "0px 3px 5px rgba(0, 0, 0, 0.2)";
            } else {
                navbar.style.backgroundColor = "transparent";
                navbar.style.boxShadow = "none";
            }
        });
    </script>


