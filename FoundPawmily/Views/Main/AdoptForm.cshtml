@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<link rel="stylesheet" href="../Content/swiper-bundle.min.css">
<link rel="stylesheet" href="../Content/main-css/adoptform.css">
<div class="container1">
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Dogs/Dog21.png" alt="Dog" class="pet-image" />
                <p class="my-2">Peanut</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Cats/Cat12.png" alt="Cat" class="pet-image" />
                <p class="my-2">Cotton</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Dogs/Dog22.png" alt="Dog" class="pet-image" />
                <p class="my-2">Bogart</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Cats/Cat13.png" alt="Cat" class="pet-image" />
                <p class="my-2">Potchi</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Dogs/Dog15.png" alt="Dog" class="pet-image" />
                <p class="my-2">Rawr</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Cats/Cat16.png" alt="Cat" class="pet-image" />
                <p class="my-2">L</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Dogs/Dog26.png" alt="Dog" class="pet-image" />
                <p class="my-2">Hotdog</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Cats/Cat17.png" alt="Cat" class="pet-image" />
                <p class="my-2">Chichi</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Dogs/Dog24.png" alt="Dog" class="pet-image" />
                <p class="my-2">Storm</p>
            </div>
            <div class="swiper-slide d-flex flex-column">
                <img src="../Content/images/Cats/Cat07.png" alt="Cat" class="pet-image" />
                <p class="my-2">Hello Kitty</p>
            </div>
        </div>
    </div>
    <div class="form-container">
        <p class="mb-0">Adopt a Pet</p>
        <p class="text-center" style="width: 43vw;">Kindly fill out the form below and we'll get back to you once we have reviewed your information via email.</p>
        <form action="" method="post" class="needs-validation" name="adoptForm" novalidate>
            <div class="row">
                <div class="col d-flex align-items-center mb-2" style="padding: 0">
                    <p class="mb-1 pe-3 title-form">Personal Information</p>
                    <hr />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-5 px-1">
                    <label for="fname" class="form-label ">First name <span style="color: red;">*</span></label>
                    <input name="fname" type="text" class="form-control no-valid-feedback" id="fname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="fname" ng-class="{'is-invalid': adoptForm.fname.$touched && adoptForm.fname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                    <div class="invalid-feedback">
                        Capitalize the first letter. Up to 50 characters only.
                    </div>
                </div>
                <div class="col-2 px-1">
                    <label for="mi" class="form-label">MI</label>
                    <input name="mi" type="text" class="form-control no-valid-feedback" ng-model="mi" ng-pattern="/^[A-ZÑ]{1,3}$/" id="mi" ng-class="{'is-invalid': adoptForm.mi.$invalid}" maxlength="3" ng-keypress="lettersOnly($event)">
                    <div class="invalid-feedback">
                        1 or 3 capital letters
                    </div>
                </div>
                <div class="col-5 px-1">
                    <label for="lname" class="form-label">Last name <span style="color: red;">*</span></label>
                    <input name="lname" type="text" class="form-control no-valid-feedback" id="lname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="lname" ng-class="{'is-invalid': adoptForm.lname.$touched && adoptForm.lname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                    <div class="invalid-feedback">
                        Capitalize the first letter. Up to 50 characters only.
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col px-1">
                    <label class="form-label d-block mb-2">Gender <span style="color: red;">*</span></label>
                    <div class="form-check-inline me-3">
                        <input class="form-check-input" type="radio" name="gender" id="male" value="Male" ng-model="gender" ng-required="true">
                        <label class="form-check-label" for="male">
                            Male
                        </label>
                    </div>
                    <div class="form-check-inline">
                        <input class="form-check-input" type="radio" name="gender" id="female" value="Female" ng-model="gender">
                        <label class="form-check-label" for="female">
                            Female
                        </label>
                    </div>
                    <div class="invalid-feedback" ng-show="adoptForm.gender.$touched && adoptForm.gender.$invalid">
                        Please select an answer.
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-5 px-1">
                    <label for="email" class="form-label">Email address <span style="color: red;">*</span></label>
                    <input name="email" type="email" class="form-control no-valid-feedback" id="email" placeholder="name@site.com" ng-model="email" ng-class="{'is-invalid': adoptForm.email.$touched && adoptForm.email.$invalid}" ng-required="true" maxlength="254">
                    <div class="invalid-feedback">
                        Please enter a valid email address.
                    </div>
                </div>
                <div class="col-4 px-1">
                    <label for="phone" class="form-label">Phone <span style="color: red;">*</span></label>
                    <div class="input-group mb-3">
                        <span class="input-group-text">+63</span>
                        <input name="phone" id="phone" type="text" class="form-control no-valid-feedback" placeholder="9XXXXXXXXX" ng-pattern="/^9\d{9}$/" ng-model="phone" ng-class="{'is-invalid': adoptForm.phone.$touched && adoptForm.phone.$invalid}" ng-required="true" maxlength="10" ng-keypress="numbersOnly($event)">
                        <div class="invalid-feedback">
                            10 digits, starting with number 9
                        </div>
                    </div>
                </div>
                <div class="col-3 px-1">
                    <label for="bday" class="form-label">Birthdate <span style="color: red;">*</span></label>
                    <input name="bday" type="date" class="form-control no-valid-feedback" id="bday" ng-model="bday" validate-age ng-class="{'is-invalid': adoptForm.bday.$touched && adoptForm.bday.$invalid}" ng-required="true" max="{{ today | date:'yyyy-MM-dd' }}">
                    <div class="invalid-feedback">
                        Must be 18yrs old or above
                    </div>
                </div>
            </div>
            <div class="row mb-2 d-flex align-items-end">
                <div class="col-2 px-1">
                    <label for="houseno" class="form-label">Address <span style="color: red;">*</span></label>
                    <input name="houseno" type="text" class="form-control no-valid-feedback" id="houseno" placeholder="House #" ng-pattern="/[0-9]+[A-Za-z\-0-9]*/" ng-model="houseno" ng-class="{'is-invalid': adoptForm.houseno.$touched && adoptForm.houseno.$invalid}" ng-required="true" maxlength="10">
                </div>
                <div class="col-5 px-1">
                    <input name="street" type="text" class="form-control no-valid-feedback" id="street" placeholder="Street" ng-pattern="/[A-Za-zÑñ0-9\s.,'\-]+/" ng-model="street" ng-class="{'is-invalid': adoptForm.street.$touched && adoptForm.street.$invalid}" ng-required="true" maxlength="50">
                </div>
                <div class="col-5 px-1">
                    <input name="brgy" type="text" class="form-control no-valid-feedback" id="brgy" placeholder="Brgy" ng-pattern="/[A-Za-z0-9\s.,'\-]+/" ng-model="brgy" ng-class="{'is-invalid': adoptForm.brgy.$touched && adoptForm.brgy.$invalid}" ng-required="true" maxlength="50">
                </div>
            </div>
            <div class="row mb-5">
                <div class="col-5 px-1">
                    <input name="city" type="text" class="form-control no-valid-feedback" id="city" placeholder="City" ng-pattern="/[A-Za-z0-9\s.,'\-]+/" ng-model="city" ng-class="{'is-invalid': adoptForm.city.$touched && adoptForm.city.$invalid}" ng-required="true" maxlength="50">
                </div>
                <div class="col-5 px-1">
                    <input name="province" type="text" class="form-control no-valid-feedback" id="province" placeholder="Province" ng-pattern="/[A-Za-z0-9\s.,'\-]+/" ng-model="province" ng-class="{'is-invalid': adoptForm.province.$touched && adoptForm.province.$invalid}" ng-required="true" maxlength="50">
                </div>
                <div class="col-2 px-1">
                    <input name="zip" type="text" class="form-control no-valid-feedback" id="zip" placeholder="ZIP" ng-pattern="/^[0-9]{4}$/" ng-model="zip" ng-class="{'is-invalid': adoptForm.zip.$touched && adoptForm.zip.$invalid}" ng-required="true" maxlength="4" ng-keypress="numbersOnly($event)">
                    <div class="invalid-feedback">
                        4 digits only
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col d-flex align-items-center mb-2" style="padding: 0">
                    <p class="mb-1 pe-3 title-form">Living Condition</p>
                    <hr />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-6 px-1">
                    <label for="resid" class="form-label">Type of Residence <span style="color: red;">*</span></label>
                    <select name="resid" id="resid" class="form-select no-valid-feedback" ng-model="resid" ng-required="true">
                        <option selected disabled value="">Select your current residence</option>
                        <option value="House">House</option>
                        <option value="Apartment">Apartment</option>
                        <option value="Condominium">Condominium</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div class="col-6 ps-4">
                    <label class="form-label d-block mb-2">Do you own or rent? <span style="color: red;">*</span></label>
                    <div class="form-check-inline">
                        <input class="form-check-input" type="radio" name="rentown" id="own" value="Own" ng-model="rentown" ng-required="true">
                        <label class="form-check-label" for="own">
                            Own
                        </label>
                    </div>
                    <div class="form-check-inline">
                        <input class="form-check-input" type="radio" name="rentown" id="rent" value="Rent" ng-model="rentown">
                        <label class="form-check-label" for="rent">
                            Rent
                        </label>
                    </div>
                    <div class="invalid-feedback" ng-show="adoptForm.rentown.$touched && adoptForm.rentown.$invalid">
                        Please select ownership type.
                    </div>
                </div>
            </div>
            <div class="row mb-5">
                <div class="col-6 px-1">
                    <label class="form-label d-block mb-2">Have you owned pets before? <span style="color: red;">*</span></label>
                    <div class="form-check-inline">
                        <input class="form-check-input" type="radio" name="petsbefore" id="yes" value="1" ng-model="ownpets" ng-required="true">
                        <label class="form-check-label" for="yes">
                            Yes
                        </label>
                    </div>
                    <div class="form-check-inline">
                        <input class="form-check-input" type="radio" name="petsbefore" id="no" value="0" ng-model="ownpets">
                        <label class="form-check-label" for="no">
                            No
                        </label>
                    </div>
                    <div class="invalid-feedback" ng-show="adoptForm.petsbefore.$touched && adoptForm.petsbefore.$invalid">
                        Please select an answer.
                    </div>
                </div>
                <div class="col-6 ps-4 pe-1">
                    <label for="listpets" class="form-label">Current pets in household (if any)</label>
                    <input name="currentpets" type="text" class="form-control no-valid-feedback" id="listpets" placeholder="1 - Cat, 2 - Dogs" ng-pattern="/^[0-9]+\s*-\s*[A-Za-z]+(?:\s*,\s*[0-9]+\s*-\s*[A-Za-z]+)*$/" ng-model="currentpets" ng-class="{'is-invalid': adoptForm.currentpets.$invalid}" maxlength="100" ng-disabled="ownpets !== '1'" ng-keypress="petPattern($event)">
                    <div class="invalid-feedback">
                        Follow the placeholder's pattern
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col d-flex align-items-center mb-2" style="padding: 0">
                    <p class="mb-1 pe-3 title-form">Pet to Adopt</p>
                    <hr />
                </div>
            </div>
            <div ng-init="getPetProfile()">
                <div class="card mb-5 w-75 p-0 mx-auto" style="max-width: 40vw" ng-if="hasSelectedPet()">
                    <div class="row g-0">
                        <div class="col-4 d-flex">
                            <img src="{{petProfileData.imagePath}}" class="img-fluid rounded-start w-100 h-100"
                                 style="object-fit: cover;">
                        </div>
                        <div class="col-8">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h5 class="card-title">{{petProfileData.name}}</h5>
                                <p class="card-text mb-0">Age: {{petProfileData.age}} years old | Gender: {{petProfileData.gender}}</p>
                                <button class="btn details-btn align-self-end mt-3" ng-click="redirectPetProfile(petProfileData.petID)">More details</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div ng-hide="hasSelectedPet()">
                    <p class="notice-text pt-4">No selected pet yet...</p>
                    <div class="d-flex gap-4 justify-content-center pb-5 pt-1 mb-3">
                        <button class="btn gallery-btn" ng-click="redirectPets('Dog')">
                            Find more Dogs
                        </button>
                        <button class="btn gallery-btn" ng-click="redirectPets('Cat')">
                            Find more Cats
                        </button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col d-flex gap-2 justify-content-center">
                    <button type="button" class="btn w-25 submit-btn" ng-click="submitAdoptForm()">Submit</button>
                    <input type="reset" name="reset" value="Cancel" class="btn w-25 cancel-btn" />
                </div>
            </div>
        </form>
    </div>
</div>
<script src="../Scripts/sweetalert2.all.min.js"></script>
<script src="../Scripts/bootstrap.bundle.min.js"></script>
<script src="../Scripts/swiper-bundle.min.js"></script>
<script>
    (() => {
        'use strict'


        const forms = document.querySelectorAll('.needs-validation')

        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }

                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>
<script>
    var swiper = new Swiper(".mySwiper", {
        effect: "cards",
        grabCursor: false,
        allowTouchMove: false,
        autoplay: {
            delay: 3000,
            disableOnInteraction: false
        },
        loop: true
    });
</script>
