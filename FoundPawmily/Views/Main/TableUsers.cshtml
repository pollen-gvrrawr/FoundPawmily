        </div>
        <div class="col container1">
            <div class="d-flex align-items-center">
                <h1 class="header-text">Users</h1>
                <button data-bs-toggle="modal" data-bs-target="#insertUser" class="btn btn-archive ms-auto">Add New User</button>
            </div>
            <div>
                <table class="table" ng-init="archivedScopeUsers()" id="userTable" style="font-size: 0.9vw;">
                    <thead>
                        <tr>
                            <th style="text-align: center">User ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th style="text-align: center">Profile</th>
                            <th style="text-align: center">Role</th>
                            <th style="text-align: center">Archived</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th style="text-align: center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="scopeVar in archiveData">
                            <td style="text-align: center">{{scopeVar.userID}}</td>
                            <td>{{scopeVar.firstName}} {{scopeVar.lastName}}</td>
                            <td>{{scopeVar.email}}</td>
                            <td><img style="width: 5vw; height: 5vw;" ng-src="{{scopeVar.imagePath}}" alt="Profile image" /></td>
                            <td>{{scopeVar.role == 1 ? 'Admin' : 'Employee'}}</td>
                            <td style="text-align: center">{{scopeVar.isArchived == 1 ? 'Deactivated' : 'Active'}}</td>
                            <td>{{scopeVar.createdAt.slice(6,-2) | date:'MMM dd, yyyy HH:mm:ss'}}</td>
                            <td>{{scopeVar.updatedAt.slice(6,-2) | date:'MMM dd, yyyy HH:mm:ss'}}</td>
                            <td class="d-flex flex-column align-items-center justify-content-center gap-1"><button class="btn transparent-btn" title="{{scopeVar.isArchived == 1 ? 'Activate' : 'Deactivate'}}" style="font-size: 0.7vw;" ng-click="ToArchivedUsers(scopeVar.userID)" ng-bind-html="scopeVar.isArchived == 1 ? inactiveIcon : activeIcon"></button><button data-bs-toggle="modal" data-bs-target="#updateUser" ng-click="getUserDataForEdit(scopeVar.userID)" class="btn edit-btn" title="Edit"><svg style="height: 1.2vw; width: 1.2vw;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="14 2 18 6 7 17 3 17 3 13 14 2"></polygon><line x1="3" y1="22" x2="21" y2="22"></line></svg></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @*UPDATE PROFILE MODAL*@
            <div class="modal fade" id="updateProfile" tabindex="-1" aria-labelledby="updateProfile" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="updateProfile">Update your Profile</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-5">
                            <form action="" method="post" class="needs-validation" name="profileForm" novalidate>
                                <div class="row mb-3">
                                    <div class="col-5">
                                        <label class="form-check-label" for="imagepath5">Profile Picture</label>
                                        <input class="form-control" type="file" name="imagepath5" id="imagepath5" accept="image/*" onchange="angular.element(this).scope().previewProfileImage(event)" />
                                        <div class="d-block fst-italic text-secondary mb-2" style="font-size: 0.8vw;">Do not upload if previous image will be used again.</div>
                                        <button type="button" class="d-block btn btn-secondary" ng-click="clearImageProfile()">Cancel Upload</button>
                                    </div>
                                    <div class="col d-flex justify-content-center">
                                        <img class="rounded-circle" ng-src="{{ profileEdit.profilePreview }}" alt="Profile picture" style="width: 12vw; height: auto;" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label for="fname" class="form-label ">First name <span style="color: red;">*</span></label>
                                        <input name="fname" type="text" class="form-control no-valid-feedback" id="fname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="profileEdit.firstName" ng-class="{'is-invalid': profileForm.fname.$touched && profileForm.fname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label for="lname" class="form-label">Last name <span style="color: red;">*</span></label>
                                        <input name="lname" type="text" class="form-control no-valid-feedback" id="lname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="profileEdit.lastName" ng-class="{'is-invalid': profileForm.lname.$touched && profileForm.lname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="email" class="form-label">Email <span style="color: red;">*</span></label>
                                        <input name="email" type="email" class="form-control no-valid-feedback" id="email" placeholder="name@site.com" ng-model="profileEdit.email" ng-class="{'is-invalid': profileForm.email.$touched && profileForm.email.$invalid}" ng-required="true" maxlength="254">
                                        <div class="invalid-feedback">
                                            Please enter a valid email address.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="userrole" class="form-label">User Role <span style="color: red;">*</span></label>
                                        <select ng-disabled="true" name="userrole" id="userrole" class="form-select no-valid-feedback" ng-model="profileEdit.role" ng-required="true">
                                            <option selected disabled value="">Select a role</option>
                                            <option value="1" ng-value="1">Admin</option>
                                            <option value="0" ng-value="0">Employee</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col px-1">
                                        <label class="form-label d-block mb-2">Will you change your password? <span style="color: red;">*</span></label>
                                        <div class="form-check-inline">
                                            <input class="form-check-input" type="radio" name="passwordprompt" id="yes" value="1" ng-value="1" ng-model="passwordprompt" ng-required="true">
                                            <label class="form-check-label" for="yes">
                                                Yes
                                            </label>
                                        </div>
                                        <div class="form-check-inline">
                                            <input class="form-check-input" type="radio" name="passwordprompt" id="no" value="0" ng-value="0" ng-model="passwordprompt">
                                            <label class="form-check-label" for="no">
                                                No
                                            </label>
                                        </div>
                                        <div class="invalid-feedback" ng-show="profileForm.passwordprompt.$touched && profileForm.passwordprompt.$invalid">
                                            Please select an answer.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3" ng-show="passwordprompt == 1">
                                    <div class="col">
                                        <label for="password1" class="form-label">New Password <span style="color: red;">*</span></label>
                                        <input name="password1" id="password1" type="password"
                                               ng-model="pass1"
                                               class="form-control"
                                               ng-class="{'is-invalid': profileForm.password1.$touched && (pass1.length < 8 || !hasUppercase(pass1) || !hasSpecialChar(pass1))}"
                                               {{passwordprompt == 1 ? 'ng-required="true"' : ''}} maxlength="128" />
                                        <div class="invalid-feedback" ng-show="(profileForm.password1.$touched || profileForm.password1.$dirty) && (!pass1 || pass1.length < 8)">
                                            Password must be at least 8 characters long.
                                        </div>
                                        <div class="invalid-feedback" ng-show="(profileForm.password1.$touched || profileForm.password1.$dirty) && !hasUppercase(pass1)">
                                            Password must contain at least one uppercase letter.
                                        </div>
                                        <div class="invalid-feedback" ng-show="(profileForm.password1.$touched || profileForm.password1.$dirty) && !hasSpecialChar(pass1)">
                                            Password must contain at least one special character.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3" ng-show="passwordprompt == 1">
                                    <div class="col">
                                        <label for="password2" class="form-label">Confirm New Password <span style="color: red;">*</span></label>
                                        <input name="password2" id="password2" type="password"
                                               ng-model="pass2"
                                               class="form-control"
                                               {{passwordprompt == 1 ? 'ng-required="true"' : ''}}
                                               ng-class="{'is-invalid': profileForm.password2.$touched && pass2 !== pass1}"
                                               maxlength="128" />
                                        <div class="invalid-feedback">
                                            Does not match the password above.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3" ng-show="passwordprompt == 1">
                                    <div class="col">
                                        <label for="oldpassword" class="form-label">Type current password to change password <span style="color: red;">*</span></label>
                                        <input name="oldpassword" id="oldpassword" type="password"
                                               ng-model="oldpass"
                                               class="form-control"
                                               {{passwordprompt == 1 ? 'ng-required="true"' : ''}}
                                               ng-class="{'is-invalid': profileForm.oldpassword.$touched && profileForm.oldpassword.$invalid}"
                                               maxlength="128" />
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-danger me-auto d-flex align-items-center" ng-click="logoutSession()"><svg style="width: 1vw; height: 1vw; margin-right: 0.5vw;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3H6a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h4M16 17l5-5-5-5M19.8 12H9" /></svg> Sign Out</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-success" ng-click="submitProfileForm()">Save</button>
                        </div>
                    </div>
                </div>
            </div>
            @*UPDATE USERS MODAL*@
            <div class="modal fade" id="updateUser" tabindex="-1" aria-labelledby="updateUser" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="updateUser">Edit User Information</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-5">
                            <form action="" method="post" class="needs-validation" name="userAdminForm" novalidate>
                                <div class="row mb-3">
                                    <div class="col-5">
                                        <label class="form-check-label" for="imagepath">Profile Picture</label>
                                        <input ng-disabled="true" class="form-control" type="file" name="imagepath" id="imagepath" accept="image/*" onchange="angular.element(this).scope().previewUserImage(event)" />
                                    </div>
                                    <div class="col d-flex justify-content-center">
                                        <img class="rounded-circle" ng-src="{{ userDataEdit.imagePreview }}" alt="Pet Image" style="width: 12vw; height: auto;" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label for="fname" class="form-label ">First name <span style="color: red;">*</span></label>
                                        <input ng-disabled="true" name="fname" type="text" class="form-control no-valid-feedback" id="fname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="userDataEdit.firstName" ng-class="{'is-invalid': userAdminForm.fname.$touched && userAdminForm.fname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label for="lname" class="form-label">Last name <span style="color: red;">*</span></label>
                                        <input ng-disabled="true" name="lname" type="text" class="form-control no-valid-feedback" id="lname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="userDataEdit.lastName" ng-class="{'is-invalid': userAdminForm.lname.$touched && userAdminForm.lname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="email" class="form-label">Email <span style="color: red;">*</span></label>
                                        <input ng-disabled="true" name="email" type="email" class="form-control no-valid-feedback" id="email" placeholder="name@site.com" ng-model="userDataEdit.email" ng-class="{'is-invalid': userAdminForm.email.$touched && userAdminForm.email.$invalid}" ng-required="true" maxlength="254">
                                        <div class="invalid-feedback">
                                            Please enter a valid email address.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="userrole" class="form-label">User Role <span style="color: red;">*</span></label>
                                        <select name="userrole" id="userrole" class="form-select no-valid-feedback" ng-model="userDataEdit.role" ng-required="true">
                                            <option selected disabled value="">Select a role</option>
                                            <option value="1" ng-value="1">Admin</option>
                                            <option value="0" ng-value="0">Employee</option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-success" ng-click="submitUserAdminForm()">Save</button>
                        </div>
                    </div>
                </div>
            </div>
            @*INSERT USERS MODAL*@
            <div class="modal fade" id="insertUser" tabindex="-1" aria-labelledby="insertUser" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
