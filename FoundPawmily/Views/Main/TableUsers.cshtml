                                        <input class="form-control mb-3" type="file" name="imagepath1" id="imagepath1" accept="image/*" onchange="angular.element(this).scope().previewUserImage1(event)" />
                                        <button type="button" class="d-block btn btn-secondary" ng-click="clearImageInsertUser()">Cancel Upload</button>
                                    </div>
                                    <div class="col d-flex justify-content-center">
                                        <img class="rounded-circle" ng-src="{{ imagePreviewUser1 }}" alt="User Profile" style="width: 12vw; height: auto;" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label for="fname" class="form-label ">First name <span style="color: red;">*</span></label>
                                        <input name="fname" type="text" class="form-control no-valid-feedback" id="fname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="fname" ng-class="{'is-invalid': userInsertAdminForm.fname.$touched && userInsertAdminForm.fname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label for="lname" class="form-label">Last name <span style="color: red;">*</span></label>
                                        <input name="lname" type="text" class="form-control no-valid-feedback" id="lname" ng-pattern="/^[A-ZÑ][a-zñ]+(?:\s[A-ZÑ][a-zñ]+)*$/" ng-model="lname" ng-class="{'is-invalid': userInsertAdminForm.lname.$touched && userInsertAdminForm.lname.$invalid}" ng-required="true" maxlength="50" ng-keypress="lettersOnly($event)">
                                        <div class="invalid-feedback">
                                            Capitalize the first letter. Up to 50 characters only.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="email" class="form-label">Email <span style="color: red;">*</span></label>
                                        <input name="email" type="email" class="form-control no-valid-feedback" id="email" placeholder="name@site.com" ng-model="email" ng-class="{'is-invalid': userInsertAdminForm.email.$touched && userInsertAdminForm.email.$invalid}" ng-required="true" maxlength="254">
                                        <div class="invalid-feedback">
                                            Please enter a valid email address.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="userrole" class="form-label">User Role <span style="color: red;">*</span></label>
                                        <select name="userrole" id="userrole" class="form-select no-valid-feedback" ng-model="userrole" ng-required="true">
                                            <option selected disabled value="">Select a role</option>
                                            <option value="1" ng-value="1">Admin</option>
                                            <option value="0" ng-value="0">Employee</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="password1" class="form-label">New Password <span style="color: red;">*</span></label>
                                        <input name="password1" id="password1" type="password"
                                               ng-model="pass1"
                                               class="form-control"
                                               ng-class="{'is-invalid': userInsertAdminForm.password1.$touched && (pass1.length < 8 || !hasUppercase(pass1) || !hasSpecialChar(pass1))}"
                                               ng-required="true" maxlength="128" />
                                        <div class="invalid-feedback" ng-show="(userInsertAdminForm.password1.$touched || userInsertAdminForm.password1.$dirty) && (!pass1 || pass1.length < 8)">
                                            Password must be at least 8 characters long.
                                        </div>
                                        <div class="invalid-feedback" ng-show="(userInsertAdminForm.password1.$touched || userInsertAdminForm.password1.$dirty) && !hasUppercase(pass1)">
                                            Password must contain at least one uppercase letter.
                                        </div>
                                        <div class="invalid-feedback" ng-show="(userInsertAdminForm.password1.$touched || userInsertAdminForm.password1.$dirty) && !hasSpecialChar(pass1)">
                                            Password must contain at least one special character.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label for="password2" class="form-label">Confirm New Password <span style="color: red;">*</span></label>
                                        <input name="password2" id="password2" type="password"
                                               ng-model="pass2"
                                               class="form-control"
                                               ng-required="true"
                                               ng-class="{'is-invalid': userInsertAdminForm.password2.$touched && pass2 !== pass1}"
                                               maxlength="128" />
