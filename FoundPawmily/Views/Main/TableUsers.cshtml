                <li class="option" data-bs-toggle="modal" data-bs-target="#updateProfile" ng-click="getProfileForEdit()">
                    <img src="@ViewBag.pfp" alt="User profile" class="rounded-circle sidebar-pfp" />
                    <p class="sidebar-text">@ViewBag.FirstName @ViewBag.LastName</p>
